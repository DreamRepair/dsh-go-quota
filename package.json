{
  "name": "dsh-go-quota",
  "version": "1.0.0",
  "private": true,
  "description": "OpenCode Go 用量状态栏：在 DSH Web 输入框旁显示 5 小时 / 本周 / 本月 额度，点开看明细",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "usage",
    "quota"
  ],
  "license": "MIT",
  "author": "DreamRepair",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DreamRepair/dsh-go-quota.git"
  },
  "homepage": "https://github.com/DreamRepair/dsh-go-quota#readme",
  "bugs": {
    "url": "https://github.com/DreamRepair/dsh-go-quota/issues"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
